{
  "name": "marion-hq",
  "private": true,
  "version": "1.0.0",
  "description": "Marion HQ \u2014 a living office game for the Marion bot ecosystem, with the Marion Mystery multiplayer arcade game.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "server": "tsx server/index.ts",
    "start:server": "NODE_ENV=production tsx server/index.ts",
    "mcp": "tsx server/mcp/stdio.ts",
    "agents": "tsx server/mcp/agents.ts",
    "start": "npm run build && npm run start:server",
    "e2e": "node tests/e2e/mystery.e2e.mjs",
    "icons": "node scripts/gen-icons.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "qrcode": "^1.5.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "^0.170.0",
    "ws": "^8.18.0",
    "zustand": "4.5.7",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/qrcode": "^1.5.5",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/three": "^0.170.0",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "jsdom": "25.0.1",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.17",
    "typescript": "5.6.3",
    "vite": "5.4.21",
    "vitest": "2.1.9"
  }
}
